# Environment configuration for ecommerce-api-legacy
# Copy to .env and fill in real values. NEVER commit a real .env.
# (P-01 — all secrets are sourced from the environment, none live in source.)

# HTTP port the API listens on.
PORT=3000

# Payment gateway credential (secret).
PAYMENT_GATEWAY_KEY=

# Database credentials / location.
# DB_LOCATION accepts a file path or ":memory:" (default) for an in-memory DB.
DB_USER=
DB_PASS=
DB_LOCATION=:memory:

# Outbound email sender.
SMTP_USER=

# Admin/auth token. When set, the auth middleware enforces a
# "Authorization: Bearer <ADMIN_TOKEN>" header on sensitive routes
# (/api/admin/*, DELETE /api/users/:id). When empty, enforcement is disabled.
ADMIN_TOKEN=
