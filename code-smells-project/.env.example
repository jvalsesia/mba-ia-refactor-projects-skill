# Copy to .env and fill in. Never commit the real .env.

# Flask signing secret — generate a strong random value.
SECRET_KEY=change-me-to-a-random-secret

# Bearer token required by /admin/* routes. Empty = admin routes deny all.
ADMIN_TOKEN=change-me-admin-token

# Runtime
DEBUG=false
HOST=0.0.0.0
PORT=5000
ENVIRONMENT=development

# Persistence
DATABASE_PATH=loja.db
